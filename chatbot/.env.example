# ============================================
# Mahlatini AI Chatbot — Environment Variables
# ============================================
# Copy this file to .env and fill in values

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mahlatini_chatbot
POSTGRES_USER=mahlatini
POSTGRES_PASSWORD=changeme_db_password

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=mahlatini_kb

# --- Groq Cloud (LLM — Provider A) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic Claude (LLM — Provider B) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- LLM Provider ---
# Which LLM to use by default: "groq" or "claude"
DEFAULT_PROVIDER=groq

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Crawler ---
WEBSITE_MIRROR_PATH=/data/website
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- n8n Webhooks ---
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_NEW_ENQUIRY=/webhook/new-enquiry
N8N_WEBHOOK_HIGH_VALUE=/webhook/high-value-lead
N8N_WEBHOOK_ESCALATION=/webhook/escalation
N8N_WEBHOOK_BOOKING_UPDATE=/webhook/booking-update

# --- Jira ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=bot@mahlatini.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=MAHT

# --- Power BI ---
POWERBI_PUSH_URL=https://api.powerbi.com/beta/your-workspace/datasets/your-dataset/rows?key=your-key
